{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(adb *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/hooks/post-compact-reminder.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Rappel : si ce .kt ajoute/modifie de la logique, crée/mets à jour le test correspondant (src/test du module).'"
          }
        ]
      }
    ]
  }
}
